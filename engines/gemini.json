{
  "name": "gemini",
  "display_name": "Gemini (Google)",
  "aliases": ["gemini", "google"],
  "service_url": "https://gemini.google.com",
  "default_model": "2.5-flash",
  "response_max_wait": 60,
  "use_baseline_comparison": false,
  "allow_unlogged": true,
  "models": {
    "2.5-flash": 32000,
    "2.0-flash": 32000,
    "1.5-flash": 100000,
    "1.5-pro": 500000,
    "unlogged": 21500,
    "default": 32000
  },
  "selectors": {
    "prompt_area": [
      "div[contenteditable='true'][data-placeholder]",
      "div[contenteditable='true'][aria-label*='Ask']",
      "div[contenteditable='true'][aria-label*='Chiedi']",
      "div[contenteditable='true'][aria-label*='Message']",
      "div[contenteditable='true'][aria-label*='Messaggio']",
      "div[contenteditable='true'][aria-label*='Enter']",
      "div[contenteditable='true'][aria-label*='Inserisci']",
      "div.ql-editor[contenteditable='true']",
      "textarea[placeholder*='Ask']",
      "textarea[placeholder*='Message']",
      "rich-textarea > div",
      "rich-textarea",
      "div[contenteditable='true']",
      "textarea"
    ],
    "send_button": [
      "button[aria-label='Send message']",
      "button[aria-label='Invia messaggio']",
      "button[aria-label*='Send message']",
      "button[aria-label*='Invia messaggio']",
      "button[data-testid='send-button']",
      "*[data-testid='send-button']",
      "button[aria-label='Send']",
      "button[aria-label='Invia']",
      "button[aria-label*='Send reply']",
      "button[type='submit']",
      "button.send-button"
    ],
    "send_button_blacklist": [
      "*[aria-label*='Stop']",
      "*[aria-label*='Cancel']",
      "*[aria-label*='Interrompi']",
      "*[aria-label*='Ferma']",
      "*[aria-label*='Annulla']",
      "*[data-testid*='stop']"
    ],
    "base_account_selector": "#app-root > main > top-bar-actions > div > div.right-section > div.buttons-container.adv-upsell.ng-star-inserted > g1-dynamic-upsell-button",
    "response_area": [
      ".assistant-message",
      ".assistant",
      ".gemini-response",
      "model-response .markdown-main-panel",
      "message-content .markdown-main-panel",
      ".markdown-main-panel",
      "model-response .markdown",
      "message-content .markdown",
      "model-response response-container .markdown",
      "structured-content-container .markdown",
      "model-response",
      ".model-response",
      ".response-container",
      "message-content",
      ".message-content",
      "div[class*='response-text']",
      "div[role='article']",
      "article"
    ],
    "accept_button": [
      "upload-image-disclaimer-dialog button[data-test-id='upload-image-agree-button']",
      "upload-image-disclaimer-dialog button[aria-label*='Agree']",
      "#mat-mdc-dialog-1 > div > div > digital-wellbeing-nudge > div > div.digital-wellbeing-nudge-actions > button > span.mat-mdc-button-touch-target"
    ],
    "stop": [
      "button[aria-label='Stop response']",
      "button[aria-label='Stop generating']",
      "button[aria-label='Cancel response']",
      "button[aria-label='Cancel generation']",
      "button[aria-label='Cancel']",
      "button[aria-label*='Stop']",
      "button[title*='Stop']",
      "button[title*='Cancel']",
      ".stop-button",
      "[data-testid='stop-button']",
      "mat-icon[fonticon='stop']",
      "button mat-icon[fonticon='stop']"
    ]
  },
  "media_support": {
    "image": {
      "limits": {"unlogged": 0, "base": 3, "paid": -1},
      "supported_models": ["all"],
      "upload_selectors": ["input[type='file'][accept*='image']", "input[type='file']"],
      "upload_complete_selectors": ["!upload-image-disclaimer-dialog"]
    },
    "audio": {
      "limits": {"unlogged": 0, "base": -1, "paid": -1},
      "supported_models": ["all"]
    },
    "document": {
      "limits": {"unlogged": 0, "base": -1, "paid": -1},
      "supported_models": ["all"],
      "upload_selectors": ["input[type='file']"],
      "upload_complete_selectors": ["!upload-image-disclaimer-dialog"]
    }
  },
  "login_detection": {
    "url_prefix": "https://gemini.google.com",
    "url_deny_keywords": ["signin", "login", "accounts.google.com"],
    "authenticated_css_selectors": [
      "div.assistant-message",
      ".gemini-response",
      ".chat-message.ai",
      "div.chat-input-container",
      "button[aria-label*='Google Account']",
      "a[href*='logout']"
    ]
  }
}

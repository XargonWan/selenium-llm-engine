{
  "name": "perplexity",
  "display_name": "Perplexity",
  "aliases": ["perplexity", "pplx"],
  "service_url": "https://www.perplexity.ai",
  "default_model": "default",
  "allow_unlogged": true,
  "notes": "After a while Perplexity might ask for a login, seems not to be blocking as the chat still works underneath.",
  "models": {
    "unlogged": 15200,
    "default": 32000
  },
  "selectors": {
    "prompt_area": [
      "div#ask-input[contenteditable='true']",
      "div[contenteditable='true'][id='ask-input']",
      "div.Publisher_input__fjtjQ div[contenteditable='true']",
      "div[contenteditable='true']",
      "textarea[placeholder*='want to know']:not([disabled])",
      "textarea.Publisher_textarea__pMX9t:not([disabled])",
      "textarea:not([disabled])"
    ],
    "send_button": [
      "button[aria-label='Submit'][data-state='closed'][type='button']",
      "div.Publisher_input__fjtjQ button[aria-label*='Submit']",
      "div.Publisher_input__fjtjQ button[type='submit']",
      "button[aria-label='Send']",
      "button[aria-label*='Send']",
      "button[aria-label*='Submit']",
      "button[type='submit']"
    ],
    "response_area": [
      "#markdown-content-0 > div > div > div",
      "div[data-renderer='lm']",
      "#markdown-content-0",
      "div.has-inline-images",
      "div.prose",
      "div.markdown"
    ],
    "stop": [
      "button[aria-label*='Stop']",
      "button[title*='Stop']",
      "button[role='button'][aria-label*='Pause']"
    ],
    "limit": [
      "div.font-serif.text-3xl.leading-[1.3].font-normal.text-foreground.selection\\:bg-super\/50.selection\\:text-foreground.dark\\:selection\\:bg-super\/10.dark\\:selection\\:text-super"
    ],
    "base_account_selector": "#root > div > div > div > div > nav > div.relative.size-full.overflow-hidden.border-subtlest.ring-subtlest.divide-subtlest.flex.flex-col > div.w-full.py-xs.border-subtlest.ring-subtlest.divide-subtlest > div > div > div > button > div.absolute.inset-0.flex.items-center.justify-center"
  },
  "media_support": {
    "total_limits": {
      "limits": {"unlogged": 0, "base": 2, "paid": -1}
    },
    "image": {
      "limits": {"unlogged": 0, "base": -1, "paid": -1},
      "supported_models": ["all"],
      "upload_selectors": ["input[type='file'][accept*='image']", "input[type='file']"]
    },
    "audio": {
      "limits": {"unlogged": 0, "base": -1, "paid": -1},
      "supported_models": ["all"]
    },
    "document": {
      "limits": {"unlogged": 0, "base": -1, "paid": -1},
      "supported_models": ["all"],
      "upload_selectors": ["input[type='file']"]
    }
  },
  "login_detection": {
    "url_prefix": "https://www.perplexity.ai"
  }
}
